{
  "landingPage": "/wp-admin/admin.php?page=site-maestro",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "steps": [
    { "step": "defineWpConfigConsts", "consts": { "WP_DEBUG": true, "WP_DEBUG_LOG": true, "WP_DEBUG_DISPLAY": false } },
    { "step": "login", "username": "admin", "password": "password" },
    { "step": "installTheme", "themeData": { "resource": "wordpress.org/themes", "slug": "hello-elementor" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "elementor" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "tutor" }, "options": { "activate": true } },
    { "step": "activatePlugin", "pluginPath": "site-maestro/site-maestro.php" },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; delete_transient('elementor_activation_redirect'); update_option('elementor_onboarded', 1); delete_transient('_wc_activation_redirect'); update_option('woocommerce_onboarding_profile', array('skipped' => true)); delete_option('_tutor_activation_redirect'); update_option('tutor_wizard', 'active');" }
  ]
}
